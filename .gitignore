# Directories that Ren'Py changes files in.
/game/saves
/game/cache

# Compiled script files. These are important for saving, and so should
# be preserved by developer and build systems after the game has been released.
/game/**/*.rpyc
/game/**/*.rpymc

# Compiled bytecode cache files
/game/cache/*.rpyb

# Translation compiled files
/game/tl/**/*.rpym
/game/tl/**/*.rpymc

# Files Ren'Py can generate.
/game/**/*.bak
/game/**/*.new
/game/**/*.old

# Error, log, and output files.
/errors.txt
/files.txt
/image_cache.txt
/log.txt
/save_dump.txt
/traceback.txt

# Launcher-generated files.
/dialogue.tab
/dialogue.txt
/strings.json

# Artefak build web (dibuat launcher Ren'Py).
/progressive_download.txt

# Voice audio (jika ditambah nanti)
/game/audio/voice/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Build artifacts and dev tools
VisualNovelDialogueGUI_PNG/
tools/
